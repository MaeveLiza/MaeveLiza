/**
 * Absolute Value Parser
 * Extracts and processes content marked with || delimiters
 * Allows for flexible matching with leaveway
 */

class AbsoluteValueParser {
    constructor() {
        this.delimiter = CONFIG.ABSOLUTE_MODE.DELIMITER;
        this.allowLeaveway = CONFIG.ABSOLUTE_MODE.ALLOW_LEAVEWAY;
        this.threshold = CONFIG.ABSOLUTE_MODE.LEAVEWAY_THRESHOLD;
        this.strictMode = CONFIG.ABSOLUTE_MODE.STRICT_MODE;
    }

    /**
     * Extract absolute value marked content from text
     * Format: ||content here||
     * Returns array of marked content items
     */
    extractAbsoluteContent(text) {
        if (!text) return [];

        const absoluteRegex = /\|\|([^\|]*?)\|\|/g;
        const matches = [];
        let match;

        while ((match = absoluteRegex.exec(text)) !== null) {
            const content = match[1].trim();
            if (content) {
                matches.push({
                    original: match[0],
                    content: content,
                    type: this.classifyContent(content),
                    position: match.index,
                    confidence: 1.0  // Perfect match
                });
            }
        }

        return matches;
    }

    /**
     * Classify content as word, sentence, or paragraph
     */
    classifyContent(content) {
        const wordCount = content.split(/\s+/).length;
        const sentenceCount = content.split(/[.!?]+/).length - 1;

        if (wordCount === 1) {
            return 'word';
        } else if (wordCount <= 20 && sentenceCount <= 1) {
            return 'sentence';
        } else {
            return 'paragraph';
        }
    }

    /**
     * Calculate similarity between two strings for leaveway matching
     * Uses Levenshtein distance algorithm
     */
    calculateSimilarity(str1, str2) {
        const s1 = str1.toLowerCase().trim();
        const s2 = str2.toLowerCase().trim();

        if (s1 === s2) return 1.0;

        const longer = s1.length > s2.length ? s1 : s2;
        const shorter = s1.length > s2.length ? s2 : s1;

        if (longer.length === 0) return 1.0;

        const editDistance = this.getEditDistance(longer, shorter);
        return (longer.length - editDistance) / longer.length;
    }

    /**
     * Calculate Levenshtein distance for fuzzy matching
     */
    getEditDistance(s1, s2) {
        const costs = [];

        for (let i = 0; i <= s1.length; i++) {
            let lastValue = i;
            for (let j = 0; j <= s2.length; j++) {
                if (i === 0) {
                    costs[j] = j;
                } else if (j > 0) {
                    let newValue = costs[j - 1];
                    if (s1.charAt(i - 1) !== s2.charAt(j - 1)) {
                        newValue = Math.min(Math.min(newValue, lastValue), costs[j]) + 1;
                    }
                    costs[j - 1] = lastValue;
                    lastValue = newValue;
                }
            }
            if (i > 0) costs[s2.length] = lastValue;
        }

        return costs[s2.length];
    }

    /**
     * Find content with leaveway - allows imperfect matches
     */
    findWithLeaveway(searchContent, textToSearch) {
        const words = textToSearch.split(/\s+/);
        const searchWords = searchContent.split(/\s+/);
        const matches = [];

        for (let i = 0; i <= words.length - searchWords.length; i++) {
            const window = words.slice(i, i + searchWords.length).join(' ');
            const similarity = this.calculateSimilarity(searchContent, window);

            if (similarity >= this.threshold) {
                matches.push({
                    content: window,
                    similarity: similarity,
                    position: i
                });
            }
        }

        return matches.length > 0 ? matches[0] : null;
    }

    /**
     * Validate absolute content
     */
    validateAbsoluteContent(absoluteItem) {
        const content = absoluteItem.content.trim();
        
        // Check minimum length
        if (content.length < 3) {
            return {
                valid: false,
                reason: 'Content too short'
            };
        }

        // Check for valid sentence/word/paragraph structure
        const type = absoluteItem.type;
        if (type === 'word') {
            return {
                valid: true,
                type: 'word'
            };
        } else if (type === 'sentence') {
            return {
                valid: true,
                type: 'sentence'
            };
        } else {
            return {
                valid: true,
                type: 'paragraph'
            };
        }
    }
}

/**
 * Main application logic for Google Docs Content Hub
 * With ABSOLUTE MODE processing
 */

class GoogleDocsContentHub {
    constructor() {
        this.cache = new Map();
        this.currentDocId = null;
        this.accountVerified = false;
        this.absoluteParser = new AbsoluteValueParser();
        this.initializeEventListeners();
        this.verifyAccount();
    }

    /**
     * Verify the Gmail account connection
     */
    verifyAccount() {
        console.log(`🔐 Initializing Content Hub for: ${CONFIG.ACCOUNT_EMAIL}`);
        console.log(`📌 ABSOLUTE MODE: Processing only ||marked|| content`);
        
        const statusDiv = document.createElement('div');
        statusDiv.className = 'account-status';
        statusDiv.innerHTML = `
            <div class="account-info">
                <span class="status-indicator">●</span>
                <strong>Connected Account:</strong> ${CONFIG.ACCOUNT_EMAIL}
            </div>
            <div class="absolute-mode-info">
                <span class="absolute-badge">ABSOLUTE MODE</span>
                Processing sentences, words, and paragraphs marked with: <code>||content||</code>
            </div>
        `;
        
        const mainElement = document.querySelector('main');
        if (mainElement && mainElement.firstChild) {
            mainElement.insertBefore(statusDiv, mainElement.firstChild);
        }
        
        this.accountVerified = true;
    }

    /**
     * Initialize event listeners for document navigation
     */
    initializeEventListeners() {
        const docLinks = document.querySelectorAll('.doc-link');
        docLinks.forEach(link => {
            link.addEventListener('click', (e) => {
                const docId = e.target.getAttribute('data-doc-id');
                this.loadDocument(docId);
            });
        });
    }

    /**
     * Load a Google Document by ID
     */
    async loadDocument(docId) {
        if (!docId || docId === 'YOUR_DOC_ID_HERE') {
            this.showError(
                `⚠️ Document ID not configured.\n\n` +
                `Please add your Google Docs IDs to config.js\n` +
                `All documents must be accessible by: ${CONFIG.ACCOUNT_EMAIL}\n\n` +
                `🔍 ABSOLUTE MODE: Only content marked with ||delimiters|| will be displayed`
            );
            return;
        }

        if (!this.accountVerified) {
            this.showError('Account verification failed. Please check your configuration.');
            return;
        }

        this.showLoader(true);
        this.currentDocId = docId;

        try {
            const cached = this.getFromCache(docId);
            if (cached) {
                this.displayContent(cached);
                this.showLoader(false);
                return;
            }

            const content = await this.fetchFromGoogleDocs(docId);
            this.setInCache(docId, content);
            this.displayContent(content);
        } catch (error) {
            this.showError(
                `❌ Error loading document: ${error.message}\n\n` +
                `Account: ${CONFIG.ACCOUNT_EMAIL}\n` +
                `Document ID: ${docId}\n\n` +
                `Please verify:\n` +
                `1. Document is shared with ${CONFIG.ACCOUNT_EMAIL}\n` +
                `2. API Key is valid and enabled\n` +
                `3. Google Docs API is enabled in Cloud Console`
            );
            console.error('Document load error:', error);
        } finally {
            this.showLoader(false);
        }
    }

    /**
     * Fetch document content from Google Docs API
     */
    async fetchFromGoogleDocs(docId) {
        console.log(`📄 Fetching document from ${CONFIG.ACCOUNT_EMAIL}'s account...`);
        
        const url = `${CONFIG.DOCS_API_URL}/${docId}?key=${CONFIG.API_KEY}`;
        const response = await fetch(url);
        
        if (!response.ok) {
            if (response.status === 403) {
                throw new Error(
                    `Access Denied (403). The document may not be shared with ${CONFIG.ACCOUNT_EMAIL}`
                );
            } else if (response.status === 404) {
                throw new Error(
                    `Document Not Found (404). Please verify the Document ID is correct.`
                );
            } else {
                throw new Error(`API Error: ${response.status} - ${response.statusText}`);
            }
        }

        const data = await response.json();
        console.log(`✓ Successfully fetched document for ${CONFIG.ACCOUNT_EMAIL}`);
        return this.parseDocumentContent(data);
    }

    /**
     * Parse Google Docs API response with ABSOLUTE MODE filtering
     */
    parseDocumentContent(docData) {
        const content = {
            title: docData.title,
            body: [],
            lastUpdated: new Date(),
            rawData: docData,
            account: CONFIG.ACCOUNT_EMAIL,
            absoluteMode: true,
            absoluteItems: []
        };

        if (docData.body && docData.body.content) {
            docData.body.content.forEach(element => {
                const parsed = this.parseElement(element);
                if (parsed) {
                    // Extract absolute value marked content
                    const absoluteContent = this.absoluteParser.extractAbsoluteContent(parsed.text);
                    
                    if (absoluteContent.length > 0) {
                        // Validate absolute items
                        const validItems = absoluteContent.filter(item => {
                            const validation = this.absoluteParser.validateAbsoluteContent(item);
                            return validation.valid;
                        });

                        if (validItems.length > 0) {
                            parsed.absoluteItems = validItems;
                            content.absoluteItems.push(...validItems);
                            content.body.push(parsed);
                        }
                    }
                }
            });
        }

        console.log(`📌 Found ${content.absoluteItems.length} absolute value items`);
        return content;
    }

    /**
     * Parse individual document elements
     */
    parseElement(element) {
        if (element.paragraph) {
            return {
                type: 'paragraph',
                text: this.extractTextFromParagraph(element.paragraph),
                style: element.paragraph.paragraphStyle
            };
        } else if (element.table) {
            return {
                type: 'table',
                data: element.table
            };
        } else if (element.heading1) {
            return {
                type: 'heading1',
                text: this.extractTextFromParagraph(element.heading1)
            };
        } else if (element.heading2) {
            return {
                type: 'heading2',
                text: this.extractTextFromParagraph(element.heading2)
            };
        } else if (element.heading3) {
            return {
                type: 'heading3',
                text: this.extractTextFromParagraph(element.heading3)
            };
        }
        return null;
    }

    /**
     * Extract text from paragraph element
     */
    extractTextFromParagraph(paragraph) {
        if (!paragraph.elements) return '';
        
        return paragraph.elements
            .map(el => el.textRun?.content || '')
            .join('')
            .trim();
    }

    /**
     * Display parsed content in the UI
     * Only shows ||marked|| absolute value content
     */
    displayContent(content) {
        const contentArea = document.getElementById('document-content');
        contentArea.innerHTML = '';

        // Document source indicator
        const sourceDiv = document.createElement('div');
        sourceDiv.className = 'document-source';
        sourceDiv.innerHTML = `
            <small>
                <span class="source-icon">📄</span>
                Source: ${content.account} | ABSOLUTE MODE ON
            </small>
        `;
        contentArea.appendChild(sourceDiv);

        // Display mode info
        const modeInfo = document.createElement('div');
        modeInfo.className = 'mode-info';
        modeInfo.innerHTML = `
            <p>
                <strong>📌 Absolute Mode Active:</strong> 
                Displaying <strong>${content.absoluteItems.length}</strong> marked items
            </p>
            <p style="font-size: 0.9em; color: #666;">
                Only content enclosed with <code>||</code> delimiters is shown
            </p>
        `;
        contentArea.appendChild(modeInfo);

        // Add title
        const titleEl = document.createElement('h2');
        titleEl.className = 'doc-title';
        titleEl.textContent = content.title;
        contentArea.appendChild(titleEl);

        // Display body with absolute filtering
        content.body.forEach(item => {
            const container = document.createElement('div');
            container.className = 'paragraph-container';

            // Create heading/paragraph
            const el = this.createElementFromParsed(item);
            if (el) {
                container.appendChild(el);
            }

            // Add absolute items from this paragraph
            if (item.absoluteItems && item.absoluteItems.length > 0) {
                const absoluteDiv = document.createElement('div');
                absoluteDiv.className = 'absolute-items';

                item.absoluteItems.forEach(absItem => {
                    const absEl = this.createAbsoluteElement(absItem);
                    if (absEl) {
                        absoluteDiv.appendChild(absEl);
                    }
                });

                container.appendChild(absoluteDiv);
            }

            contentArea.appendChild(container);
        });

        // Summary
        const summary = document.createElement('div');
        summary.className = 'absolute-summary';
        summary.innerHTML = `
            <p>
                <strong>✓ Absolute Summary:</strong><br>
                • Words: ${content.absoluteItems.filter(i => i.type === 'word').length}<br>
                • Sentences: ${content.absoluteItems.filter(i => i.type === 'sentence').length}<br>
                • Paragraphs: ${content.absoluteItems.filter(i => i.type === 'paragraph').length}
            </p>
        `;
        contentArea.appendChild(summary);

        // Update timestamp
        document.getElementById('last-updated').textContent = 
            `${content.lastUpdated.toLocaleString()} (${content.account}) - ABSOLUTE MODE`;
    }

    /**
     * Create element for absolute value item
     */
    createAbsoluteElement(absItem) {
        const el = document.createElement('div');
        el.className = `absolute-item absolute-${absItem.type}`;

        const badge = document.createElement('span');
        badge.className = 'type-badge';
        badge.textContent = absItem.type.toUpperCase();

        const content = document.createElement('span');
        content.className = 'absolute-content';
        content.textContent = absItem.content;

        const confidence = document.createElement('span');
        confidence.className = 'confidence';
        confidence.textContent = `${Math.round(absItem.confidence * 100)}%`;

        el.appendChild(badge);
        el.appendChild(content);
        el.appendChild(confidence);

        return el;
    }

    /**
     * Create HTML element from parsed content
     */
    createElementFromParsed(parsedItem) {
        let el = null;

        switch (parsedItem.type) {
            case 'heading1':
                el = document.createElement('h1');
                el.textContent = parsedItem.text;
                break;
            case 'heading2':
                el = document.createElement('h2');
                el.textContent = parsedItem.text;
                break;
            case 'heading3':
                el = document.createElement('h3');
                el.textContent = parsedItem.text;
                break;
            case 'paragraph':
                el = document.createElement('p');
                el.className = 'original-paragraph';
                el.textContent = parsedItem.text;
                break;
            case 'table':
                el = this.createTableElement(parsedItem.data);
                break;
        }

        return el;
    }

    /**
     * Create table element
     */
    createTableElement(tableData) {
        const table = document.createElement('table');
        table.className = 'content-table';
        return table;
    }

    /**
     * Cache management - get
     */
    getFromCache(docId) {
        const cached = this.cache.get(docId);
        if (!cached) return null;

        const age = Date.now() - cached.timestamp;
        const maxAge = CONFIG.CACHE_DURATION_MINUTES * 60 * 1000;

        if (age > maxAge) {
            this.cache.delete(docId);
            return null;
        }

        return cached.content;
    }

    /**
     * Cache management - set
     */
    setInCache(docId, content) {
        this.cache.set(docId, {
            content: content,
            timestamp: Date.now()
        });
    }

    /**
     * Clear cache
     */
    clearCache() {
        this.cache.clear();
        console.log('Cache cleared for ' + CONFIG.ACCOUNT_EMAIL);
    }

    /**
     * Get account information
     */
    getAccountInfo() {
        return {
            email: CONFIG.ACCOUNT_EMAIL,
            verified: this.accountVerified,
            cachedDocuments: this.cache.size,
            absoluteModeEnabled: CONFIG.ABSOLUTE_MODE.ENABLED
        };
    }

    /**
     * Show/hide loader
     */
    showLoader(show) {
        const loader = document.getElementById('loader');
        if (show) {
            loader.style.display = 'block';
        } else {
            loader.style.display = 'none';
        }
    }

    /**
     * Display error message
     */
    showError(message) {
        const contentArea = document.getElementById('document-content');
        contentArea.innerHTML = `
            <div class="error-message">
                <p>${message}</p>
            </div>
        `;
    }
}

